# LibrePool catalog feed service — copy to .env and fill in.
# NEVER commit a real .env, a real Stripe key, or a real ranking key.

# Port the feed service listens on.
CATALOG_PORT=8080
# Host to bind (127.0.0.1 for local dev).
CATALOG_HOST=127.0.0.1

# Ed25519 signing key. Dev default is catalog/dev-keys/signing-private.pem
# (git-ignored; see catalog/README.md). Production keys live on the feed host
# only — never in this repo. Either a path or an inline PEM (with \n escapes).
CATALOG_SIGNING_KEY_PATH=./dev-keys/signing-private.pem
# CATALOG_SIGNING_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Seed catalog (the feed's source of truth — its own data, not a router DB).
CATALOG_SEED_PATH=./data/seed-catalog.json

# License store file (JSON, dev-only; production needs a real store).
CATALOG_LICENSE_DB_PATH=./data/licenses.json

# Stripe — placeholders only until Stripe is wired (see catalog/README.md).
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=price_...          # $19/yr annual-only price
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PORTAL_URL=                 # optional: fixed billing-portal URL returned by /v1/portal until Stripe portal sessions are wired

# Ranking keys — placeholders only. Free-tier keys, fetched by the feed
# service at export time; per-source scores NEVER enter the catalog JSON.
# LIBREPOOL_RANKING_AA_KEY=
# LIBREPOOL_RANKING_BENCHLM_KEY=
# LIBREPOOL_RANKING_LIVEBENCH_KEY=
