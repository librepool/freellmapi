# LibrePool catalog feed service — copy to .env and fill in.
# NEVER commit a real .env, a real Stripe key, or a real ranking key.

# Port the feed service listens on.
CATALOG_PORT=8080
# Host to bind (127.0.0.1 for local dev).
CATALOG_HOST=127.0.0.1

# Ed25519 signing key. Dev default is catalog/dev-keys/signing-private.pem
# (git-ignored; see catalog/README.md). Production keys live on the feed host
# only — never in this repo. Either a path or an inline PEM (with \n escapes).
CATALOG_SIGNING_KEY_PATH=./dev-keys/signing-private.pem
# CATALOG_SIGNING_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Seed catalog (the feed's source of truth — its own data, not a router DB).
CATALOG_SEED_PATH=./data/seed-catalog.json

# License store file (SQLite via node:sqlite; see catalog/docs/license-store.md).
# Legacy JSON stores migrate with: node scripts/migrate-licenses.ts
CATALOG_LICENSE_DB_PATH=./data/licenses.db

# Stripe — real checkout/webhook/portal (see catalog/README.md + src/stripe.ts).
# Create a $19.00 USD recurring price, interval `year`, in the Stripe
# dashboard first; no lifetime SKU. Webhook endpoint: POST /v1/stripe/webhook,
# subscribed to checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=price_...          # $19/yr annual-only price
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=https://librepool.com/premium/success
# STRIPE_CANCEL_URL=https://librepool.com/premium/cancel
# STRIPE_PORTAL_RETURN_URL=https://librepool.com/premium
# STRIPE_PORTAL_URL=                 # optional dev-only portal fallback
# Purchase email: EMAIL_TRANSPORT=log (dev, prints only) or resend.
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=
# EMAIL_FROM=LibrePool <noreply@librepool.com>   # must be a verified sender
# RESEND_API_URL=https://api.resend.com/emails  # optional override
# EMAIL_REPLY_TO=                              # optional

# Ranking keys — placeholders only. Free-tier keys, fetched by the feed
# service at export time; per-source scores NEVER enter the catalog JSON.
# Run: node scripts/fetch-rankings.ts (dry-run default; --apply to merge).
# LIBREPOOL_RANKING_AA_KEY=
# LIBREPOOL_RANKING_BENCHLM_KEY=
# LiveBench has no API: drop its Overall scores in catalog/data/livebench.json
# (git-ignored operator data) and re-run the fetch job. No LiveBench key exists.
